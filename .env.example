# Docker Compose용 환경변수 예시
# 이 파일을 복사해 루트에 `.env`로 저장한 뒤 값을 채운다.
#   cp .env.example .env
#
# `.env`는 Git에 커밋하지 않는다 (.gitignore에 등록됨).
# 실제 비밀번호·시크릿은 여기에 넣지 말고, 복사한 `.env`에만 설정한다.

# --- MySQL (Compose 서비스명: mysql) ---
MYSQL_DATABASE=sevenknights
MYSQL_USER=
MYSQL_PASSWORD=
# MySQL 공식 이미지 기동에 필요 (앱 접속 계정과 달라도 됨)
MYSQL_ROOT_PASSWORD=

# --- Backend → MySQL 연결 ---
# Compose 내부에서는 호스트명이 서비스 이름 `mysql` 이다.
DB_URL=jdbc:mysql://mysql:3306/sevenknights?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
# Spring datasource 계정 (보통 MYSQL_USER / MYSQL_PASSWORD 와 동일하게 맞춤)
DB_USERNAME=
DB_PASSWORD=

# JWT 서명 키 — 32자 이상 권장 (실제 값은 `.env`에만 설정)
JWT_SECRET=

# 브라우저가 프론트에 접속할 origin (CORS). 여러 개는 콤마로 구분
# 로컬: http://localhost:3000
# EC2:  http://YOUR_EC2_PUBLIC_IP:3000  또는  https://your.domain
CORS_ALLOWED_ORIGINS=http://localhost:3000

UPLOAD_DIR=/app/uploads
HERO_SEED=false
PET_SEED=false

BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- Frontend (빌드 인자) ---
# 브라우저가 API를 호출할 주소. Docker 서비스명(backend)이 아니라 공개 URL을 넣는다.
# 로컬: http://localhost:8080
# EC2:  http://YOUR_EC2_PUBLIC_IP:8080  또는  https://api.your.domain
# 값을 바꾼 뒤에는 frontend 이미지를 다시 빌드해야 한다.
NEXT_PUBLIC_API_URL=http://localhost:8080
